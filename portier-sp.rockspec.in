rockspec_format = "3.0"
package = "portier-sp"
version = "@VERSION@"
source = {
  url = "@CWD@/portier-sp-@VERSION@.tar.gz"
}
description = {
  summary = "Service provider side of portier single sign-on for OpenResty",
  detailed = [[
    Verifies the portier session token that arrives in a cookie on every
    request in the nginx access phase: signature against the identity
    provider's JWKS, expiry, issuer and audience, then the service provider's
    own policy over the claims (required grants, denied groups). Sets the
    nginx variables the site passes to the application as REMOTE_USER.
    Carries the config loader and the token module that portier-idp also
    uses.
  ]],
  homepage = "https://github.com/NetworkRADIUS/portier-nginx",
  license = "AGPL-3.0"
}
dependencies = {
  "lua >= 5.1",
  "lua-resty-jwt >= 0.2.0",
  "lua-resty-openssl >= 0.6.8",
  "lua-resty-http",
  -- resty.jwt pulls resty.string/resty.random, which OpenResty bundles via
  -- lua-resty-core but a distro nginx does not. Pull it explicitly.
  "lua-resty-string",
  "lua-cjson"
}
build = {
   type = "builtin",
@MOD_LIST@,
   install = {
     conf = {
       ["nginx/portier-sp-http.conf"] = "etc/nginx/portier-sp-http.conf"
     }
   }
}
